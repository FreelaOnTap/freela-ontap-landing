{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(privacidade|termos|suporte)",
      "destination": "/index.html"
    },
    {
      "source": "/vaga/:id",
      "destination": "/index.html"
    }
  ]
}
